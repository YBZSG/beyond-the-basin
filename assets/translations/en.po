msgid "当前不是 Forward+，光照与水体效果不完整。\n请检查本机 Godot 渲染设备与 Vulkan / Direct3D 12 支持。"
msgstr "Forward+ is inactive. Lighting and water effects are incomplete.\nCheck your Godot renderer and Vulkan / Direct3D 12 support."

msgid "新角色不可用，已保留原版探索者。"
msgstr "The new character is unavailable. The original explorer is active."

msgid "泳池"
msgstr "Pool"

msgid "实验预览：仅主池厅有原生烘焙，SDFGI 暂停；其余 4 厅保留直接光/环境光，但间接光不等价。退出恢复所选 GI。\n"
msgstr "Experimental preview. Only the main pool hall has baked lighting. SDFGI is paused. The other four halls retain direct and ambient light. Your GI setting returns on exit.\n"

msgid "BAKE UNAVAILABLE · 原场景保留："
msgstr "BAKE UNAVAILABLE · Original scene retained. "

msgid "WASD 移动 · Esc 菜单"
msgstr "WASD Move · Esc Menu"

msgid "正在切换场景 / SWITCHING WORLD…"
msgstr "Switching world…"

msgid "正在释放上一场景 / RELEASING PREVIOUS WORLD…"
msgstr "Releasing previous world…"

msgid "正在准备水体 / PREPARING WATER…"
msgstr "Preparing water…"

msgid "继续探索 / CONTINUE"
msgstr "Continue exploring"

msgid "进入泳池 / CONTINUE"
msgstr "Enter the pool"

msgid "请输入整数种子（不可含小数或字母）。 / Enter an integer seed (no decimals or letters)."
msgstr "Enter an integer seed without decimals or letters."

msgid "种子超出有符号 64 位整数范围。 / Seed is outside the signed 64-bit range.\n-9223372036854775808 … 9223372036854775807"
msgstr "Seed is outside the signed 64-bit range.\n-9223372036854775808 … 9223372036854775807"

msgid "正在加载场景"
msgstr "Loading scene"

msgid "水体准备尚未完成；原世界保留，可重试。"
msgstr "Water preparation is incomplete. Your current world is retained. Try again."

msgid "水体准备超时。已保留当前世界与机关进度，请重试或安全退出。"
msgstr "Water preparation timed out. Your world and puzzle progress are retained. Retry or exit safely."

msgid "场景尚未准备完成，请等待后继续或返回菜单重试。"
msgstr "The scene is still preparing. Wait to continue or return to the menu and retry."

msgid "POOLCORE · PC EXPLORER EDITION\n原版 / 主池厅 / 扩展随机地图 · 骨骼角色 · 原水体交互"
msgstr "POOLCORE · PC EXPLORER EDITION\nOriginal pools / Main hall / Expanded maps · Animated explorer · Interactive water"

msgid "出生地 / STARTING WORLD"
msgstr "Starting world"

msgid "原仓库场景 / ORIGINAL"
msgstr "Original pools"

msgid "重做主池厅 / FORMAL HALL"
msgstr "Main pool hall"

msgid "扩展随机地图 / EXPANDED"
msgstr "Expanded maps"

msgid "曲廊池区 / POOLROOMS WING"
msgstr "Poolrooms wing"

msgid "五境参考场景 / REFERENCE WING"
msgstr "Reference wing"

msgid "在此出生"
msgstr "Spawn here"

msgid "重启到所选世界 / RESTART INTO SELECTED WORLD"
msgstr "Restart into selected world"

msgid "完全退出后重新打开；可选兼容方式，不保证修复黑屏/绿屏。 / Optional fresh-process fallback, not a black/green-screen fix."
msgstr "Exit fully and reopen in the selected world. Optional compatibility restart."

msgid "实验主池厅烘焙 / EXPERIMENTAL PC PREVIEW"
msgstr "Experimental main hall bake"

msgid "前往"
msgstr "Travel"

msgid "重建种子世界"
msgstr "Rebuild seeded world"

msgid "原生间接光 / SDFGI"
msgstr "Indirect lighting / SDFGI"

msgid "水下焦散 / CAUSTICS"
msgstr "Underwater caustics"

msgid "即时切换外观；不重置关卡、持物或存档。原版可随时切回。"
msgstr "Switch appearance instantly. Your level, held item and saves are retained."

msgid "显示角色身体 / PLAYER BODY"
msgstr "Player body"

msgid "衣物织纹 / CLOTH FINISH"
msgstr "Cloth weave"

msgid "主厅设施互动 / QUIET VALVES"
msgstr "Facility interactions"

msgid "深水步行减速 / DEPTH RESPONSE"
msgstr "Depth slowdown"

msgid "声音 / ORIGINAL SOUND EFFECTS"
msgstr "Sound effects"

msgid "空间底噪 / AMBIENCE"
msgstr "Ambience"

msgid "镜头：原始 / CLEAN"
msgstr "Lens · Clean"

msgid "镜头：CCD 摄像机"
msgstr "Lens · CCD camera"

msgid "镜头：VHS 录像"
msgstr "Lens · VHS"

msgid "镜头：冷色纪实"
msgstr "Lens · Cool documentary"

msgid "镜头：模拟摄像机 / 青绿柔光"
msgstr "Lens · Soft teal camera"

msgid "水体与图层设置 / WATER"
msgstr "Water settings"

msgid "WASD 移动 · Shift 奔跑 · Space 跳跃 · E 扶梯/阀门\n左键抓取/拖动 · 右键蓄力投掷 · 滚轮：上推远 / 下拉近\nL 手电筒开关 · H 隐藏界面 · G 诊断 · F11 全屏 · Esc 暂停"
msgstr "WASD Move · Shift Run · Space Jump · E Ladder / Valve\nLeft mouse Grab / Drag · Right mouse Charge throw · Wheel Adjust distance\nL Flashlight · H Hide HUD · G Diagnostics · F11 Fullscreen · Esc Pause"

msgid "复制运行诊断 / COPY DIAGNOSTICS"
msgstr "Copy diagnostics"

msgid "退出 / QUIT"
msgstr "Quit"

msgid "已切换，但无法保存角色偏好；下次启动可能恢复旧选择。"
msgstr "Character switched. Saving the preference failed. The previous choice may return next time."

msgid "角色载入失败；保留当前角色。可继续使用原版探索者。"
msgstr "Character loading failed. The current character remains active."

msgid "原生水体 / WATER & LAYERS"
msgstr "Water and layers"

msgid "轻微室内风纹 · 水面光学近似，非完整风场物理。\n关闭风纹仍保留脚步、涉水和物体交互。"
msgstr "Subtle indoor wind ripples use an optical approximation.\nFootstep, wading and object ripples remain active when wind ripples are disabled."

msgid "恢复轻微室内风 / RESET WIND"
msgstr "Reset indoor wind"

msgid "只恢复风纹开关、强度、方向和细密度，不改变其他水体、画质、阴影或交互设置。"
msgstr "Reset wind ripple enable, strength, direction and density."

msgid "平面反射（原仓库镜像相机）"
msgstr "Planar reflections"

msgid "深度折射"
msgstr "Depth refraction"

msgid "原仓库体积光束 / SOURCE LIGHT SHAFTS"
msgstr "Volumetric light shafts"

msgid "显示水面"
msgstr "Show water"

msgid "完整水面"
msgstr "Complete surface"

msgid "浅水高度"
msgstr "Shallow-water height"

msgid "速度场"
msgstr "Velocity field"

msgid "模拟法线"
msgstr "Simulation normals"

msgid "细波纹"
msgstr "Fine ripples"

msgid "最终法线"
msgstr "Final normals"

msgid "水深"
msgstr "Water depth"

msgid "折射"
msgstr "Refraction"

msgid "焦散"
msgstr "Caustics"

msgid "反射"
msgstr "Reflections"

msgid "浮沫"
msgstr "Foam"

msgid "返回 / BACK"
msgstr "Back"

msgid "已复制诊断 / COPIED"
msgstr "Diagnostics copied"

msgid "仅支持桌面版 / Desktop only."
msgstr "Desktop only."

msgid "缺少完整启动参数 / Missing exact launcher arguments."
msgstr "Exact launcher arguments are missing."

msgid "启动信息无效 / Invalid launch identity."
msgstr "Invalid launch identity."

msgid "启动程序不匹配 / Executable identity differs."
msgstr "Executable identity differs."

msgid "仅支持同名相邻 PCK / Matching adjacent PCK required."
msgstr "A matching adjacent PCK is required."

msgid "启动参数无效 / Invalid launch argument."
msgstr "Invalid launch argument."

msgid "启动参数过多 / Too many launch arguments."
msgstr "Too many launch arguments."

msgid "自定义场景/编辑器/测试启动不支持重启 / Exit fully; relaunch with supplied CMD, not custom scene/editor/test arguments."
msgstr "Exit fully and relaunch with the supplied CMD launcher."

msgid "预览/测试模式不支持重启 / Preview or QA mode is unsupported."
msgstr "Preview or QA mode does not support restarting."

msgid "当前参数与启动器不一致 / Current user arguments differ from launcher."
msgstr "Current arguments differ from the launcher."

msgid "渲染器与启动参数不一致 / Active renderer differs from launch arguments."
msgstr "Active renderer differs from the launch arguments."

msgid "请完全退出后通过启动器打开 / Exit fully and use the launcher, not the editor/debugger."
msgstr "Exit fully and open through the launcher."

msgid "请完全退出后用随包 CMD 启动器打开 / Exit fully and use the supplied CMD launcher."
msgstr "Exit fully and use the supplied CMD launcher."

msgid "启动信息损坏 / Invalid launcher contract."
msgstr "Invalid launcher contract."

msgid "启动文件已移动 / Executable or matching PCK is missing."
msgstr "Executable or matching PCK is missing."

msgid "当前启动方式不支持重启 / Current invocation is unsupported."
msgstr "This invocation does not support restarting."

msgid "正在切换或退出，请稍候 / A transition or shutdown is already in progress."
msgstr "A transition or shutdown is already in progress."

msgid "出生地或回调无效 / Invalid selection or callback."
msgstr "Invalid starting world or callback."

msgid "设置保存失败，未退出 / Settings save failed; game remains open."
msgstr "Settings could not be saved. The game remains open."

msgid "未能请求重启，请手动重新打开 / Restart could not be armed; reopen manually."
msgstr "Restart could not be prepared. Reopen manually."

msgid "已保存，正在完全退出并重新打开 / Saved; exiting fully and reopening."
msgstr "Saved. Exiting fully and reopening."

msgid "旧泳池"
msgstr "Old pool"

msgid "水拍旧瓷砖，跳台隐在高处。"
msgstr "Water laps against old tiles. A diving platform hides above."

msgid "漂浮物厅"
msgstr "Floating objects hall"

msgid "漂浮物轻碰池沿，空厅传来细响。"
msgstr "Floating objects tap the edge. A faint sound crosses the empty hall."

msgid "沉阶水厅"
msgstr "Submerged steps"

msgid "阶沿没入浅水，脚下仍有去路。"
msgstr "The steps sink into shallow water. A path remains underfoot."

msgid "高拱门大厅"
msgstr "High arch hall"

msgid "日光穿过高拱，回声拉长。"
msgstr "Daylight crosses the high arches. The echoes stretch."

msgid "夜间浴场"
msgstr "Night baths"

msgid "低顶灯下，一段电流声并不平稳。"
msgstr "Beneath low ceiling lights, an electrical hum falters."

msgid "跳台高廊"
msgstr "Diving platform gallery"

msgid "高处栏杆映着光，水声留在下方。"
msgstr "Light catches the high railings. Water sounds below."

msgid "连通浴池"
msgstr "Connected baths"

msgid "浅水连接岛台，干湿脚步交替。"
msgstr "Shallow water links the islands. Footsteps alternate between wet and dry."

msgid "柱阵水厅"
msgstr "Pillared pool hall"

msgid "柱影层层延伸，水声绕过暗处。"
msgstr "Rows of shadows extend into the distance. Water echoes around them."

msgid "淋浴更衣间"
msgstr "Showers and changing rooms"

msgid "长凳划开干湿区，滴水声贴近墙面。"
msgstr "Benches divide wet and dry. Drops fall close to the wall."

msgid "低拱静浴"
msgstr "Low-arched baths"

msgid "四座浅池围着步道，低拱收住回声。"
msgstr "Four shallow pools border a path. Low arches hold the echoes."

msgid "天窗泳廊"
msgstr "Skylight gallery"

msgid "真实天光落入蓝瓷，水面缓慢映亮。"
msgstr "Daylight falls across blue tiles. The water slowly brightens."

msgid "设备过渡厅"
msgstr "Service transition"

msgid "设备门旁的导向牌，在风机声里静止。"
msgstr "A sign beside the service door stands still in the fan's hum."

msgid "曲廊镜池"
msgstr "Curved mirror pool"

msgid "曲墙遮住池尾，反光先到达脚边。"
msgstr "A curved wall hides the far end. Reflected light reaches your feet first."

msgid "拱顶水廊"
msgstr "Vaulted water lanes"

msgid "两条水道向前延伸，天光只剩窄缝。"
msgstr "Two channels continue ahead. Daylight narrows to a slit."

msgid "圆门侧浴"
msgstr "Circular-door baths"

msgid "圆门框住静水，休息龛里声音变轻。"
msgstr "A round doorway frames still water. Sound softens in the resting alcove."

msgid "釉光阶厅"
msgstr "Glazed stair hall"

msgid "干燥的楼梯向下，砖缝接住灯影。"
msgstr "Dry stairs descend. Tile joints catch the light."

msgid "暗柱水厅"
msgstr "Dark pillar hall"

msgid "中轴灯照出方柱，侧面依然安静。"
msgstr "Central lamps reveal square columns. The sides stay quiet."

msgid "青窗水廊"
msgstr "Teal window channel"

msgid "青窗照着水道，旧标志留在原位。"
msgstr "Teal windows light the waterway. Old signs remain in place."

msgid "粉阶八角池"
msgstr "Pink octagonal pool"

msgid "粉色阶沿环住八角水面，穹顶叠起。"
msgstr "Pink steps surround an octagonal pool beneath layered vaults."

msgid "圆窗球池休息室"
msgstr "Round-window ball lounge"

msgid "软垫收住脚步声，圆窗嵌在墙里。"
msgstr "Soft mats absorb your footsteps. A round window rests in the wall."

msgid "天光环庭"
msgstr "Daylight ring court"

msgid "天光穿过环庭，风在上层绕行。"
msgstr "Daylight crosses the ring court. Wind circles above."

msgid "穹顶泳廊"
msgstr "Vaulted swimming gallery"

msgid "拱券重复，长水道尽头仍留着暖光。"
msgstr "Arches repeat. Warm light remains at the end of the long channel."

msgid "更衣回廊"
msgstr "Changing gallery"

msgid "旧柜与淋浴间之间，浅水漫过砖缝。"
msgstr "Between old lockers and showers, shallow water covers the tile joints."

msgid "采光主池厅"
msgstr "Daylit main pool"

msgid "宽阔的水面接住自然光，空气渐静。"
msgstr "Natural light rests on the broad pool. The air grows still."

msgid "连续拱廊"
msgstr "Continuous arcade"

msgid "干地脚步穿过一道又一道拱门。"
msgstr "Dry footsteps pass through arch after arch."

msgid "静水侧池"
msgstr "Still side pool"

msgid "侧池没有另一扇出口，适合停留片刻。"
msgstr "The side pool has one entrance. Stay for a moment."

msgid "浅水天井"
msgstr "Shallow courtyard"

msgid "天空打开，浅浅的水几乎贴着地面。"
msgstr "The sky opens above water that barely covers the ground."

msgid "穹顶静浴"
msgstr "Domed quiet bath"

msgid "水光托着穹顶，远处终于有了风声。"
msgstr "Reflected light supports the dome. At last, wind sounds in the distance."

msgid "值班室铜钥匙"
msgstr "Duty-room brass key"

msgid "漂流防水筒"
msgstr "Floating waterproof tube"

msgid "水位刻度片"
msgstr "Water-level scale"

msgid "拱厅铭牌"
msgstr "Arch hall plaque"

msgid "夜班保险丝"
msgstr "Night-shift fuse"

msgid "跳台检修卡"
msgstr "Diving platform service card"

msgid "连池阀柄"
msgstr "Connecting pool valve handle"

msgid "柱厅线路图"
msgstr "Pillar hall wiring plan"

msgid "第一章 · 无人的值班"
msgstr "Chapter One · An Unattended Shift"

msgid "找回八处值班记录，恢复检修通道。"
msgstr "Recover eight duty records and restore maintenance access."

msgid "开启检修井"
msgstr "Open maintenance shaft"

msgid "你沿着还在工作的灯，寻找上一班留下的交接物。"
msgstr "Follow the lights still working. Find what the previous shift left behind."

msgid "更衣柜门牌"
msgstr "Locker number plate"

msgid "静浴阀门芯"
msgstr "Quiet bath valve core"

msgid "天窗反射片"
msgstr "Skylight reflector"

msgid "设备室通行章"
msgstr "Service-room pass"

msgid "第二章 · 恢复水路"
msgstr "Chapter Two · Restore the Waterways"

msgid "收集四件维护部件，打开下层回水通道。"
msgstr "Collect four maintenance parts and open the lower return channel."

msgid "打开回水井"
msgstr "Open return shaft"

msgid "水路依旧通向更深处，检修记录却停在了昨天。"
msgstr "The pipes lead deeper. The maintenance records end yesterday."

msgid "曲廊黄铜徽章"
msgstr "Curved gallery brass badge"

msgid "水廊压力表"
msgstr "Water lane pressure gauge"

msgid "圆门锁芯"
msgstr "Round-door lock core"

msgid "第三章 · 回水的方向"
msgstr "Chapter Three · The Return Flow"

msgid "找齐三件回水装置，解锁旧浴场的下行口。"
msgstr "Find three return-flow components and unlock the way down."

msgid "释放下行舱"
msgstr "Release descent chamber"

msgid "反光里的门重复出现，但只有一扇与水声相连。"
msgstr "Doors repeat in the reflections. Only one follows the sound of water."

msgid "阶厅编号瓷片"
msgstr "Numbered stair hall tile"

msgid "暗柱灯管端盖"
msgstr "Dark pillar lamp end cap"

msgid "青窗红色通行牌"
msgstr "Teal window red pass"

msgid "八角池刻度环"
msgstr "Octagonal pool scale ring"

msgid "圆窗房旧手环"
msgstr "Old round-window wristband"

msgid "第四章 · 五间记忆"
msgstr "Chapter Four · Five Rooms of Memory"

msgid "五处遗留物组成最后一份交接记录。"
msgstr "Five objects form the final handover record."

msgid "进入深层采光井"
msgstr "Enter the deep light well"

msgid "这里既像公共浴场，也像被水浸湿的记忆。"
msgstr "This place feels like a public bath and a memory soaked in water."

msgid "环庭通风栅片"
msgstr "Ring court vent grille"

msgid "穹廊检修尺"
msgstr "Vaulted gallery service ruler"

msgid "旧更衣柜手牌"
msgstr "Old locker wrist tag"

msgid "第五章 · 封存的静翼"
msgstr "Chapter Five · The Sealed Quiet Wing"

msgid "取回三件旧馆遗留物，重启通往采光层的通风井。"
msgstr "Recover three objects from the old wing and restart the ventilation shaft."

msgid "打开通风井"
msgstr "Open ventilation shaft"

msgid "新馆的交接记录，指向一片早已封存的旧馆。"
msgstr "The new wing's handover records point toward an old, sealed hall."

msgid "主池泵房钥匙"
msgstr "Main pool pump-room key"

msgid "拱廊玻璃棱片"
msgstr "Arcade glass prism"

msgid "侧池排水塞"
msgstr "Side pool drain plug"

msgid "天井日照刻度"
msgstr "Courtyard sunlight scale"

msgid "穹顶出口铭牌"
msgstr "Dome exit plaque"

msgid "第六章 · 光的出口"
msgstr "Chapter Six · A Way into the Light"

msgid "完成最后五处交接，开启回到地面的出口。"
msgstr "Complete the final five handovers and open the way to the surface."

msgid "完成交接 · 开启出口"
msgstr "Complete handover · Open exit"

msgid "水不再向下流，远处终于有了风声。"
msgstr "Water no longer flows down. At last, wind sounds in the distance."

msgid "隔离故障照明支路并恢复馈电。"
msgstr "Isolate the faulty lighting circuit and restore the main supply."

msgid "平衡相互牵制的三路水压。"
msgstr "Balance the three linked water pressures."

msgid "重定向回水并稳定出口水位。"
msgstr "Redirect the return flow and stabilize the outlet level."

msgid "按建筑回声重演四拍记忆。"
msgstr "Replay the four-beat memory through the building's echoes."

msgid "按联锁次序恢复旧馆通风。"
msgstr "Restore the old wing's ventilation in interlock order."

msgid "汇聚日光并开启穹顶出口。"
msgstr "Gather daylight and open the domed exit."

msgid "通过侧向检修门"
msgstr "Pass through the side service door"

msgid "启动泵房升降台"
msgstr "Start pump-room lift"

msgid "穿过弯曲回水廊"
msgstr "Cross the curved return channel"

msgid "推开记忆屏风"
msgstr "Push open the memory screen"

msgid "打开通风检修门"
msgstr "Open ventilation service door"

msgid "走向日光出口"
msgstr "Walk toward the daylight exit"

msgid "上一班没有留下钥匙，只留下仍在呼吸的电路。"
msgstr "The previous shift left breathing circuits in place of keys."

msgid "水压彼此牵制，静止的指针也能讲述管路的方向。"
msgstr "The pressures pull against each other. Even a still needle reveals the pipes' direction."

msgid "出口不在最响的水声后面，而在两段流向相遇的地方。"
msgstr "The exit lies where two currents meet."

msgid "空间记得经过它的次序。"
msgstr "The space remembers the order of your steps."

msgid "先让噪声停止，再让空气流动。"
msgstr "Let the noise stop, then let the air move."

msgid "光需要方向，不需要通行证。"
msgstr "Light needs direction."

msgid "检修设备"
msgstr "Maintenance equipment"

msgid "主馈电复位杆"
msgstr "Main supply reset lever"

msgid "浅池照明支路"
msgstr "Shallow pool lighting"

msgid "深池照明支路"
msgstr "Deep pool lighting"

msgid "拱厅照明支路"
msgstr "Arch hall lighting"

msgid "夜班照明支路"
msgstr "Night-shift lighting"

msgid "跳台照明支路"
msgstr "Diving platform lighting"

msgid "连池照明支路"
msgstr "Connecting pool lighting"

msgid "柱厅照明支路"
msgstr "Pillar hall lighting"

msgid "淋浴旁通阀"
msgstr "Shower bypass valve"

msgid "静浴回流阀"
msgstr "Quiet bath return valve"

msgid "天窗补水阀"
msgstr "Skylight supply valve"

msgid "设备室压力验收"
msgstr "Service-room pressure check"

msgid "曲廊分流器"
msgstr "Curved gallery diverter"

msgid "双廊导流器"
msgstr "Twin channel diverter"

msgid "圆池出口闸"
msgstr "Circular pool outlet gate"

msgid "阶厅起音踏板"
msgstr "Stair hall opening pedal"

msgid "暗柱回音踏板"
msgstr "Dark pillar echo pedal"

msgid "青窗折返踏板"
msgstr "Teal window return pedal"

msgid "八角终音踏板"
msgstr "Octagonal final pedal"

msgid "圆窗记忆验收"
msgstr "Round-window memory check"

msgid "环庭噪声隔离闸"
msgstr "Ring court noise isolation gate"

