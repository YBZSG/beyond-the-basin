extends SceneTree
## Independent migration/integrity tests; fixtures generated by unmodified revision-1 source.
const State=preload("res://scripts/campaign/campaign_state.gd")
var failures:Array[String]=[]
var checks:=0
func check(value:bool,label:String)->void:
 checks+=1
 if not value:failures.append(label);push_error(label)
func _initialize()->void:
 var fixtures:Variant=JSON.parse_string(FileAccess.get_file_as_string("res://tests/campaign/independent/legacy_v1_migration_fixtures.json"))
 check(fixtures is Array and fixtures.size()==20,"20 authentic legacy fixtures loaded")
 for row:Dictionary in fixtures:
  var state=State.new()
  var result:Dictionary=state.restore(row.save)
  check(result.get("ok",false),row.name+" accepted")
  if not result.get("ok",false):continue
  check(state.chapter_index==int(row.save.chapter_index),row.name+" stays on proven chapter")
  check(state.completed==row.save.completed,row.name+" completion preserved")
  check(not state.pending_transition,row.name+" pending safely cleared")
  for id:String in row.save.inventory:check(state.inventory.has(id),row.name+" item preserved "+id)
  var output:Dictionary=state.serialize()
  var roundtrip=State.new()
  check(roundtrip.restore(JSON.parse_string(JSON.stringify(output))).get("ok",false),row.name+" new roundtrip valid")
  check(JSON.parse_string(JSON.stringify(roundtrip.serialize()))==JSON.parse_string(JSON.stringify(output)),row.name+" new roundtrip exact")
  var stable:Dictionary=state.serialize().duplicate(true)
  for field:String in ["seed","chapter_index","revision"]:
   for value:Variant in [-1,0.25,"0",null,INF,NAN]:
    var malformed:Dictionary=stable.duplicate(true);malformed[field]=value
    check(not state.restore(malformed).get("ok",false),row.name+" reject malformed "+field+"="+str(value))
    check(state.serialize()==stable,row.name+" malformed restore nonmutating")
  for field:String in ["inventory","visited"]:
   var malformed:Dictionary=stable.duplicate(true);malformed[field]=["not-a-real-id"]
   check(not state.restore(malformed).get("ok",false),row.name+" reject unknown "+field)
   check(state.serialize()==stable,row.name+" unknown restore nonmutating")
  var malformed:Dictionary=stable.duplicate(true);malformed.pending_transition="false"
  check(not state.restore(malformed).get("ok",false),row.name+" reject transition coercion")
  check(state.serialize()==stable,row.name+" coercion nonmutating")
 print("INDEPENDENT_MIGRATION_TEST ",JSON.stringify({"checks":checks,"failures":failures}))
 quit(0 if failures.is_empty() else 1)
