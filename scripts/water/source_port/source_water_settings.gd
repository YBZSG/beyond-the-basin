static func sanitize_wind_settings(saved: Variant) -> Dictionary:
	# Migrate only this feature. Preserve legacy aliases, unknown future values,
	# and all unrelated water overrides rather than silently resetting them.
	var result: Dictionary = saved.duplicate(true) if saved is Dictionary else {}
	var enabled: Variant = result.get("windWaves", DEFAULT.windWaves)
	result["windWaves"] = enabled if enabled is bool else DEFAULT.windWaves
	for row: Dictionary in SLIDERS:
		if row.key not in WIND_KEYS: continue
		var value: Variant = result.get(row.key, row.defval)
		result[row.key] = clampf(float(value), row.min, row.max) if (value is float or value is int) and is_finite(float(value)) else row.defval
	return result
