class_name AvatarFinishCandidate
extends RefCounted
## Optional, reversible material-only finish for the separate metric-UV GLB.
## Apply AFTER PoolAvatar.setup() has constructed its planar-aware materials.
## Never changes a mesh, skeleton, animation, movement, or water state.
## No automatic wetness: a general "in water" flag is not per-cloth contact.

const FINISH_SHADER: Shader = preload("res://shaders/avatar_finish_candidate.gdshader")
const SHIRT_NORMAL: Texture2D = preload("res://assets/textures/avatar_finish/shirt_plain_normal.png")
const SHIRT_ROUGHNESS: Texture2D = preload("res://assets/textures/avatar_finish/shirt_plain_roughness.png")
const TROUSER_NORMAL: Texture2D = preload("res://assets/textures/avatar_finish/trousers_twill_normal.png")
const TROUSER_ROUGHNESS: Texture2D = preload("res://assets/textures/avatar_finish/trousers_twill_roughness.png")
const SHIRT_NAME: String = "Explorer | warm ivory woven shirt"
const TROUSERS_NAME: String = "Explorer | charcoal cotton trousers"
const CANDIDATE_PATH: String = "res://assets/textures/avatar_finish/avatar_finish_candidate.glb"

var _changes: Array[Dictionary] = []
var _enabled: bool = false


func apply_to(root: Node, enabled: bool = true) -> Dictionary:
	if not is_instance_valid(root):
		return {"applied_surfaces": 0, "error": "A live imported avatar root is required."}
	if not _changes.is_empty():
		return {"applied_surfaces": 0, "error": "Restore this candidate before applying it again."}
	var result: Dictionary = {"applied_surfaces": 0, "skipped": [], "enabled": enabled}
	_apply_node(root, enabled, result)
	_enabled = enabled and not _changes.is_empty()
	return result


func _apply_node(node: Node, enabled: bool, result: Dictionary) -> void:
	for child: Node in node.get_children():
		_apply_node(child, enabled, result)
	if not node is MeshInstance3D:
		return
	var instance: MeshInstance3D = node as MeshInstance3D
	if instance.mesh == null or instance.material_override != null:
		return
	for surface: int in instance.mesh.get_surface_count():
		var imported: Material = instance.mesh.surface_get_material(surface)
		if imported == null or imported.resource_name not in [SHIRT_NAME, TROUSERS_NAME]:
			continue
		var surface_name: String = imported.resource_name
		var arrays: Array = instance.mesh.surface_get_arrays(surface)
		if not _has_metric_uv_contract(arrays):
			result.skipped.append(surface_name + ": missing candidate metre UV2/tangent contract; original V2 is intentionally refused.")
			continue
		var original: Material = instance.get_active_material(surface)
		var replacement: ShaderMaterial = _make_material(original, surface_name, enabled)
		if replacement == null:
			result.skipped.append(surface_name + ": unsupported existing material; left unchanged.")
			continue
		_changes.append({"mesh": weakref(instance), "surface": surface,
			"previous_override": instance.get_surface_override_material(surface), "candidate": replacement})
		instance.set_surface_override_material(surface, replacement)
		result.applied_surfaces += 1


func _has_metric_uv_contract(arrays: Array) -> bool:
	if arrays.size() != Mesh.ARRAY_MAX:
		return false
	var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
	var uv_variant: Variant = arrays[Mesh.ARRAY_TEX_UV2]
	var tangent_variant: Variant = arrays[Mesh.ARRAY_TANGENT]
	if not uv_variant is PackedVector2Array or not tangent_variant is PackedFloat32Array:
		return false
	var uv: PackedVector2Array = uv_variant
	var tangents: PackedFloat32Array = tangent_variant
	if uv.size() != vertices.size() or tangents.size() != vertices.size() * 4:
		return false
	# The separate candidate's metre charts extend beyond 0..1, unlike an
	# autogenerated lightmap UV. These bounds also reject the frozen original.
	var max_u: float = -INF
	var min_v: float = INF
	for value: Vector2 in uv:
		max_u = maxf(max_u, value.x)
		min_v = minf(min_v, value.y)
	return max_u > 3.5 and max_u < 4.2 and min_v < -4.0 and min_v > -10.0


func _make_material(original: Material, surface_name: String, enabled: bool) -> ShaderMaterial:
	var result := ShaderMaterial.new()
	result.shader = FINISH_SHADER
	result.resource_name = surface_name + " | optional dry cloth finish"
	if original is ShaderMaterial:
		var shader_source := original as ShaderMaterial
		if shader_source.shader == null or shader_source.shader.resource_path not in [
			"res://shaders/avatar_body.gdshader", "res://shaders/avatar_finish_candidate.gdshader"]:
			return null
		for uniform: Dictionary in shader_source.shader.get_shader_uniform_list():
			var value: Variant = shader_source.get_shader_parameter(uniform.name)
			if value != null:
				result.set_shader_parameter(uniform.name, value)
	elif original is BaseMaterial3D:
		_copy_pbr_source(original as BaseMaterial3D, result)
	else:
		return null
	result.render_priority = original.render_priority
	var shirt: bool = surface_name == SHIRT_NAME
	result.set_shader_parameter("fabric_enabled", enabled)
	result.set_shader_parameter("fabric_uv_repeat", Vector2.ONE / (0.0224 if shirt else 0.0256))
	result.set_shader_parameter("fabric_normal_texture", SHIRT_NORMAL if shirt else TROUSER_NORMAL)
	result.set_shader_parameter("fabric_roughness_texture", SHIRT_ROUGHNESS if shirt else TROUSER_ROUGHNESS)
	result.set_shader_parameter("fabric_normal_strength", 1.0)
	result.set_shader_parameter("fabric_specular", 0.30 if shirt else 0.50)
	return result


func _copy_pbr_source(source: BaseMaterial3D, result: ShaderMaterial) -> void:
	result.set_shader_parameter("albedo_color", source.albedo_color)
	result.set_shader_parameter("albedo_texture", source.albedo_texture)
	result.set_shader_parameter("has_albedo_texture", source.albedo_texture != null)
	result.set_shader_parameter("roughness_value", source.roughness)
	result.set_shader_parameter("roughness_texture", source.roughness_texture)
	result.set_shader_parameter("has_roughness_texture", source.roughness_texture != null)
	result.set_shader_parameter("roughness_channel", _channel_mask(source.roughness_texture_channel))
	result.set_shader_parameter("metallic_value", source.metallic)
	result.set_shader_parameter("metallic_texture", source.metallic_texture)
	result.set_shader_parameter("has_metallic_texture", source.metallic_texture != null)
	result.set_shader_parameter("metallic_channel", _channel_mask(source.metallic_texture_channel))
	result.set_shader_parameter("specular_value", source.metallic_specular)
	result.set_shader_parameter("normal_texture", source.normal_texture)
	result.set_shader_parameter("normal_enabled", source.normal_enabled and source.normal_texture != null)
	result.set_shader_parameter("normal_scale", source.normal_scale)
	result.set_shader_parameter("ao_texture", source.ao_texture)
	result.set_shader_parameter("ao_enabled", source.ao_enabled and source.ao_texture != null)
	result.set_shader_parameter("ao_channel", _channel_mask(source.ao_texture_channel))
	result.set_shader_parameter("ao_light_affect", source.ao_light_affect)
	result.set_shader_parameter("emission_color", source.emission)
	result.set_shader_parameter("emission_energy", source.emission_energy_multiplier)
	result.set_shader_parameter("emission_enabled", source.emission_enabled)
	result.set_shader_parameter("emission_texture", source.emission_texture)
	result.set_shader_parameter("has_emission_texture", source.emission_texture != null)
	result.set_shader_parameter("emission_multiply", source.emission_operator == BaseMaterial3D.EMISSION_OP_MULTIPLY)
	result.set_shader_parameter("uv_scale", Vector2(source.uv1_scale.x, source.uv1_scale.y))
	result.set_shader_parameter("uv_offset", Vector2(source.uv1_offset.x, source.uv1_offset.y))
	result.set_shader_parameter("vertex_color_albedo", source.vertex_color_use_as_albedo)
	result.set_shader_parameter("texture_repeat_enabled", source.texture_repeat)
	result.set_shader_parameter("source_cull_mode", source.cull_mode)
	result.set_shader_parameter("alpha_scissor_enabled", source.transparency == BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR)
	result.set_shader_parameter("alpha_scissor_threshold", source.alpha_scissor_threshold)
	if source is ORMMaterial3D:
		var orm: Texture2D = (source as ORMMaterial3D).orm_texture
		for parameter: String in ["roughness_texture", "metallic_texture", "ao_texture"]:
			result.set_shader_parameter(parameter, orm)
		result.set_shader_parameter("has_roughness_texture", orm != null)
		result.set_shader_parameter("has_metallic_texture", orm != null)
		result.set_shader_parameter("ao_enabled", source.ao_enabled and orm != null)
		result.set_shader_parameter("roughness_channel", Vector4(0, 1, 0, 0))
		result.set_shader_parameter("metallic_channel", Vector4(0, 0, 1, 0))
		result.set_shader_parameter("ao_channel", Vector4(1, 0, 0, 0))


func _channel_mask(channel: int) -> Vector4:
	match channel:
		BaseMaterial3D.TEXTURE_CHANNEL_GREEN:
			return Vector4(0, 1, 0, 0)
		BaseMaterial3D.TEXTURE_CHANNEL_BLUE:
			return Vector4(0, 0, 1, 0)
		BaseMaterial3D.TEXTURE_CHANNEL_ALPHA:
			return Vector4(0, 0, 0, 1)
		BaseMaterial3D.TEXTURE_CHANNEL_GRAYSCALE:
			return Vector4(1.0 / 3.0, 1.0 / 3.0, 1.0 / 3.0, 0)
	return Vector4(1, 0, 0, 0)


func set_enabled(enabled: bool) -> void:
	for change: Dictionary in _changes:
		(change.candidate as ShaderMaterial).set_shader_parameter("fabric_enabled", enabled)
	_enabled = enabled and not _changes.is_empty()


func restore() -> int:
	var restored: int = 0
	for change: Dictionary in _changes:
		var instance: MeshInstance3D = (change.mesh as WeakRef).get_ref() as MeshInstance3D
		if is_instance_valid(instance) and instance.get_surface_override_material(change.surface) == change.candidate:
			instance.set_surface_override_material(change.surface, change.previous_override)
			restored += 1
	_changes.clear()
	_enabled = false
	return restored


func is_enabled() -> bool:
	return _enabled
