+++ b/servers/rendering/renderer_rd/effects/dlss_nr.h
@@ -0,0 +1,11 @@
+#pragma once
+#include "servers/rendering/renderer_rd/storage_rd/render_scene_buffers_rd.h"
+
+namespace RendererRD {
+// Experimental single-view SDR path; called after tonemapping, before Canvas/HUD.
+class DLSSNR {
+public:
+ static void process(const Ref<RenderSceneBuffersRD> &rb, RID target, Vector2 jitter, bool reset);
+ static void shutdown();
+};
+}
