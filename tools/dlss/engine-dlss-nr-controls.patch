+void publish_status(bool supported, const char *state, const String &reason, bool force = false) {
+	status.state = state;
+	status.reason = reason;
+	const uint64_t now = OS::get_singleton()->get_ticks_msec();
+	const bool unchanged = status.has_emitted && status.emitted_supported == supported &&
+		status.emitted_state == status.state && status.emitted_reason == reason && status.emitted_capability == status.capability &&
+		status.emitted_request.revision == status.requested.revision && status.emitted_request.same_values(status.requested) &&
+		status.emitted_applied_revision == status.applied_revision && status.emitted_applied_layers == status.applied_layers &&
+		status.emitted_applied.same_values(status.applied);
+	// Avoid per-frame Dictionary/JSON work as well as throttling environment writes.
+	if (!force && unchanged && now - status.last_emit_msec < 1000) { return; }
+	status.has_emitted = true;
+	status.emitted_supported = supported;
+	status.emitted_state = status.state; status.emitted_reason = reason; status.emitted_capability = status.capability;
+	status.emitted_request = status.requested; status.emitted_applied = status.applied;
+	status.emitted_applied_revision = status.applied_revision; status.emitted_applied_layers = status.applied_layers;
+	status.last_emit_msec = now;
+	Dictionary data;
+	data["schema"] = 1;
+	data["supported"] = supported; // Build/SDK support, not a claim about the GPU.
+	data["capability"] = status.capability;
+	data["state"] = status.state;
+	data["reason"] = status.reason;
+	data["requested_revision"] = status.requested.revision;
+	data["applied_revision"] = status.applied_revision;
+	data["requested_layers"] = status.requested.layers;
+	data["applied_layers"] = status.applied_layers;
+	data["requested"] = controls_dictionary(status.requested);
+	data["applied"] = status.applied_layers > 0 ? controls_dictionary(status.applied) : Dictionary();
+	data["process_id"] = OS::get_singleton()->get_process_id();
+	data["emitted_msec"] = now;
+	data["successful_frames"] = status.successful_frames;
+	OS::get_singleton()->set_environment("POOLCORE_NR_STATUS_V1", JSON::stringify(data));
+}
+void inactive_status(bool supported, const char *state, const String &reason) {
+	status.applied_layers = 0;
+	status.applied_revision = -1;
+	publish_status(supported, state, reason);
+}
