+#pragma once
+// SDK-independent validation shared with the source-contract test executable.
+#include <cmath>
+#include <cstdint>
+
+namespace PoolCoreNR {
+constexpr int MAX_LAYERS = 4;
+struct Controls {
+	int64_t revision = 0;
+	int layers = 1;
+	float intensity = 1.0f;
+	float tone = 0.1f;
+	float structure = 0.5f;
+	bool same_values(const Controls &other) const {
+		return layers == other.layers && intensity == other.intensity && tone == other.tone && structure == other.structure;
+	}
+};
+inline float strength(double value, float fallback) {
+	if (!std::isfinite(value)) { return fallback; }
+	return static_cast<float>(value < 0.0 ? 0.0 : (value > 1.0 ? 1.0 : value));
+}
+inline int layers(double value) {
+	if (!std::isfinite(value) || std::floor(value) != value) { return 1; }
+	return value < 1.0 ? 1 : (value > MAX_LAYERS ? MAX_LAYERS : static_cast<int>(value));
+}
+inline int64_t revision(double value) {
+	if (!std::isfinite(value) || std::floor(value) != value || value < 0.0 || value > 9007199254740991.0) { return 0; }
+	return static_cast<int64_t>(value);
+}
