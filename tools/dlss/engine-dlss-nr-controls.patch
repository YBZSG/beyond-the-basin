+PoolCoreNR::Controls read_controls() {
+	// Parse only changed snapshots. Invalid/missing JSON safely restores original defaults.
+	static String previous;
+	static PoolCoreNR::Controls cached;
+	static bool has_previous = false;
+	String raw = OS::get_singleton()->get_environment("POOLCORE_NR_CONTROL_V1");
+	if (has_previous && raw == previous) { return cached; }
+	has_previous = true; previous = raw; cached = PoolCoreNR::Controls();
+	if (raw.is_empty()) { return cached; }
+	JSON parser;
+	if (parser.parse(raw) != OK) { return cached; }
+	Variant parsed = parser.get_data();
+	PoolCoreNR::Controls value;
+	if (parsed.get_type() != Variant::DICTIONARY) { return value; }
+	Dictionary data = parsed;
+	auto number = [&data](const char *key, double fallback) -> double {
+		Variant v = data.get(key, fallback);
+		return v.get_type() == Variant::FLOAT || v.get_type() == Variant::INT ? static_cast<double>(v) : fallback;
+	};
+	value.revision = PoolCoreNR::revision(number("revision", 0));
+	value.layers = PoolCoreNR::layers(number("layers", 1));
+	value.intensity = PoolCoreNR::strength(number("intensity", 1.0), 1.0f);
+	value.tone = PoolCoreNR::strength(number("tone", 0.1), 0.1f);
+	value.structure = PoolCoreNR::strength(number("structure", 0.5), 0.5f);
+	cached = value;
+	return cached;
+}
+Dictionary controls_dictionary(const PoolCoreNR::Controls &value) {
+	Dictionary data;
+	data["layers"] = value.layers;
+	data["intensity"] = value.intensity;
+	data["tone"] = value.tone;
+	data["structure"] = value.structure;
+	return data;
+}
