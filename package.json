{
  "name": "beyond-the-basin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint app tests",
    "benchmark:build": "vite build --config vite.benchmark.config.ts",
    "typecheck": "tsc -p tsconfig.pool-vct.json",
    "apk:web": "vite build --config vite.apk.config.ts",
    "apk": "powershell -NoProfile -ExecutionPolicy Bypass -File build-apk.ps1",
    "single": "vite build --config vite.single.config.ts && node build-single.mjs",
    "test": "node --experimental-strip-types --test tests/pool-vct.test.mjs tests/pool-physics.test.mjs tests/pool-water.test.mjs tests/pool-particles.test.mjs tests/pool-room-repair.test.mjs tests/pool-perf.test.mjs tests/pool-liquid-pass.test.mjs tests/pool-film-chain.test.mjs tests/pool-liquid-tsl.test.mjs tests/pool-worker.test.mjs"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.2"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@webgpu/types": "^0.1.72",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "description": "BEYOND THE BASIN | PoolCore — procedural indoor pool exploration"
}
